# Trading Cockpit local/deployment configuration.
# Copy this file to .env and replace placeholders with real values.
# Never commit .env or credential/key files.

# Public browser OAuth client ID used by Vite at build time.
VITE_TRADING_COCKPIT_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Local web mode. Use "mock" for UI-only development, "http" to call the local API through Vite.
VITE_TRADING_COCKPIT_GATEWAY=mock
VITE_TRADING_COCKPIT_API_PROXY_TARGET=http://localhost:8080

# API runtime configuration.
TRADING_COCKPIT_SPREADSHEET_ID=your-google-spreadsheet-id
TRADING_COCKPIT_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
TRADING_COCKPIT_ALLOWED_EMAILS=you@example.com
TRADING_COCKPIT_ALLOWED_ORIGINS=http://localhost:5173,https://your-cloud-run-service.run.app

# Secret Manager resource name that stores the Finviz token.
# This is not the Finviz token value.
TRADING_COCKPIT_FINVIZ_TOKEN_SECRET=projects/your-project/secrets/your-finviz-token-secret/versions/latest

# Local API port. Cloud Run provides PORT automatically.
PORT=8080

# Google Cloud deployment configuration.
TRADING_COCKPIT_GCP_PROJECT=your-google-project-id
TRADING_COCKPIT_GCP_REGION=northamerica-northeast1
TRADING_COCKPIT_ARTIFACT_REPOSITORY=your-artifact-repository
TRADING_COCKPIT_CLOUD_RUN_SERVICE=your-cloud-run-service-name
TRADING_COCKPIT_CLOUD_RUN_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
TRADING_COCKPIT_CLOUD_RUN_MIN_INSTANCES=0
TRADING_COCKPIT_CLOUD_RUN_MAX_INSTANCES=1
