{
  "name": "@trading-cockpit/cloud-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.js --external:google-auth-library --external:googleapis",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@trading-cockpit/backend-core": "*",
    "@trading-cockpit/contracts": "*",
    "google-auth-library": "^10.5.0",
    "googleapis": "^168.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
